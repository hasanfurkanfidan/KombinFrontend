{
  "expo": {
    "name": "Kombin",
    "slug": "kombin-mobile",
    "scheme": "kombin",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.kombin.mobile",
      "usesAppleSignIn": true
    },
    "android": {
      "package": "app.kombin.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "expo-notifications",
      "expo-font",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Dolabına parça eklemek için kıyafetinin fotoğrafını çekmemiz gerekiyor.",
          "photosPermission": "Dolabına parça eklemek için galerinden kıyafet fotoğrafı seçmene izin ver.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.821421028055-caocq1ii1c3q6g75djk1cbb725vau9vc"
        }
      ],
      "expo-apple-authentication"
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "fdd216c0-52e9-4a41-b363-58dba9125607"
      }
    },
    "owner": "hasanfurkanfidan"
  }
}
